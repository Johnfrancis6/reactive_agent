# ── App ──────────────────────────────────────────
APP_NAME=reactive_agent
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────
# Docker : host = db (service name)
# Local  : host = localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432



LLM_GENERATOR=openai/gpt-oss-120b
LLM_CLARIFIER=openai/gpt-oss-20b

# ── SMTP (optional) ──────────────────────────────
# Leave empty to disable the email tool
# Gmail : use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ksfranco341@gmail.com
SMTP_PASSWORD=iksjwjoiburzegqx
SMTP_FROM_EMAIL=ksfranco341@gmail.com

# ── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000