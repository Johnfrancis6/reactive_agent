# ── App ──────────────────────────────────────────
APP_NAME=reactive_agent
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────
# Docker : host = db (service name)
# Local  : host = localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ── LLM ──────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_GENERATOR=llama-3.3-70b-versatile
LLM_CLARIFIER=llama-3.1-8b-instant

# ── SMTP (optional) ──────────────────────────────
# Leave empty to disable the email tool
# Gmail : use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# ── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000